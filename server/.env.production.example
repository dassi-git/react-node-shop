# Managed MongoDB connection; do not use a local or in-memory database in production.
DATABASE_URI=mongodb+srv://username:password@cluster.example.mongodb.net/production

# Generate a long random value and store it in a secret manager.
ACCESS_TOKEN_SECRET=replace-with-a-long-random-production-secret

PORT=8888
NODE_ENV=production
CLIENT_URL=https://your-production-domain.example

# SMTP credentials belong in the deployment secret store.
EMAIL_USER=production-mail@example.com
EMAIL_PASSWORD=replace-with-smtp-secret

# Optional future providers. The active customer flow currently uses manual payment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.paypal.com